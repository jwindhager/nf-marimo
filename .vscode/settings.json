{
  "python.analysis.diagnosticsSource": "Pylance + Pyrefly",
  // use the project's pixi environment (python, ruff, pyrefly, pytest, nextflow, ...)
  "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  // lint + format with ruff from the pixi env (configured in pyproject.toml)
  "ruff.importStrategy": "fromEnvironment",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  }
}
