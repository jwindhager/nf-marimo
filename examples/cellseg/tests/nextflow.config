// Config for module tests (nf-test)
params {
    idr0033a_url = 'https://livingobjects.ebi.ac.uk/idr/zarr/v0.5/idr0033A/BR00109990_C2.zarr/0'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    gpu {
        docker.runOptions = '-u $(id -u):$(id -g) --gpus all'
        process {
            withLabel: 'process_gpu' {
                accelerator = 1
            }
        }
    }
    conda {
        conda.enabled = true
    }
}

process {
    // segment/quantify a lower pyramid level to keep tests fast
    withName: 'CELLPOSE_OMEZARR' {
        ext.args = '--level 2'
    }
    withName: 'QUANTIFY_OMEZARR' {
        ext.args = '--level 2'
    }
}
