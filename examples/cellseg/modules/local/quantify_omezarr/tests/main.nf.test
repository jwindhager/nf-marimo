nextflow_process {

    name "Test Process QUANTIFY_OMEZARR"
    script "../main.nf"
    process "QUANTIFY_OMEZARR"

    tag "modules"
    tag "modules_local"
    tag "quantify_omezarr"

    setup {
        run("CELLPOSE_OMEZARR") {
            script "../../cellpose_omezarr/main.nf"
            process {
                """
                input[0] = channel.of([ [ id:'test' ], [], params.idr0033a_url ])
                input[1] = 'Nuclei,Actin/Golgi/Membrane'
                input[2] = []
                """
            }
        }
    }

    test("idr0033A - local segmented zarr") {

        when {
            process {
                """
                input[0] = CELLPOSE_OMEZARR.out.zarr.map { meta, zarr -> [ meta, zarr, '' ] }
                input[1] = 'cellpose'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.anndata[0][1]).exists() },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("idr0033A - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([ [ id:'test' ], [], params.idr0033a_url ])
                input[1] = 'cellpose'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
